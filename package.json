{
  "name": "tp7-satellite-tracker",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "postinstall": "node scripts/patch-expo-cli.cjs",
    "mitigation:check": "node scripts/patch-expo-cli.cjs --check",
    "test:cli-mitigation": "powershell -NoProfile -File scripts/test-cli-mitigation.ps1",
    "start": "expo start",
    "proxy:local": "tsx server/start-local-proxy.ts",
    "android": "expo run:android",
    "ios": "expo start --ios",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "export:android": "expo export --platform android",
    "map:import": "node scripts/import-world-land.cjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.23",
    "expo-background-task": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.19",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.27",
    "expo-task-manager": "~58.0.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "satellite.js": "6.0.2"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/react": "~19.3.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
}
